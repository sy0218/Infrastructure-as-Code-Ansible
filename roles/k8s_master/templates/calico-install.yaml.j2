# Calico Installation CR (k8s_master 롤이 배포 — 값은 인벤토리 host.yml에서 관리)
apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  calicoNetwork:
    linuxDataplane: Iptables # 기본값이지만 명시 (eBPF 아님 — kube-proxy iptables 모드와 병행)
    ipPools:
      - cidr: {{ pod_subnet }} # kubeadm podSubnet과 반드시 일치
        encapsulation: VXLANCrossSubnet
        natOutgoing: Enabled
    nodeAddressAutodetectionV4:
      cidrs:
        - {{ node_cidr }} # host-only NIC를 정확히 잡도록 (NAT NIC 오인 방지)
---
apiVersion: operator.tigera.io/v1
kind: APIServer
metadata:
  name: default
spec: {}
